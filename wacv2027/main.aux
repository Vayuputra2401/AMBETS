\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Causal intervention, rendered.} Top: input, ground truth, routing argmax, baseline prediction. Grid: rows are the \emph  {source} concept, columns the \emph  {target}; each cell is the segmentation after forcing every token the router assigned to the row concept through the column concept's expert, with the re-routed region outlined in white. The diagonal is the identity control and is pixel-identical to the baseline (changed-voxel fraction $0$ for all three), so the off-diagonal changes are attributable to re-routing alone.}}{6}{figure.caption.24}\protected@file@percent }
\newlabel{fig:intervention}{{1}{6}{\textbf {Causal intervention, rendered.} Top: input, ground truth, routing argmax, baseline prediction. Grid: rows are the \emph {source} concept, columns the \emph {target}; each cell is the segmentation after forcing every token the router assigned to the row concept through the column concept's expert, with the re-routed region outlined in white. The diagonal is the identity control and is pixel-identical to the baseline (changed-voxel fraction $0$ for all three), so the off-diagonal changes are attributable to re-routing alone}{figure.caption.24}{}}
\newlabel{fig:intervention@cref}{{[figure][1][]1}{[1][5][]6}{}{}{}}
